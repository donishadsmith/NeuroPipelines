#!/bin/bash
#SBATCH --job-name=fmriprep
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=48:00:00
# Outputs -----------------------------------------------------------------
#SBATCH --output=/projects/bigos_lab/mph-study/code/logs/fmriprep_%A_%a.out
#SBATCH --error=/projects/bigos_lab/mph-study/code/logs/fmriprep_%A_%a.err
# -------------------------------------------------------------------------
# Use --array=0-NUMSUBS (e.g., sbatch --array=0-16 fmriprep.sb) to process multiple subjects at the same time
FMRIPREP_VERSION="25.2.3"

DATASET="mph"
COHORT="kids" # kids, adults

BAD_NODES_FILE="/projects/bigos_lab/${DATASET}-study/code/logs/bad_nodes_${SLURM_ARRAY_JOB_ID}.txt"

if ! getent passwd $(id -u) > /dev/null 2>&1; then
    echo "$(hostname)" >> "$BAD_NODES_FILE"
    sort -u -o "$BAD_NODES_FILE" "$BAD_NODES_FILE"
    echo "Can't determine user account information on $(hostname). Requeueing job"
    SCONTROL_STRING="update JobId=${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} ExcNodeList=$(paste -sd, "$BAD_NODES_FILE")"
    scontrol requeue ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}
    scontrol $SCONTROL_STRING
    exit 0
fi

PYTHON="/projects/bigos_lab/envs/py313/bin/python"
FS_LICENSE="/projects/bigos_lab/freesurfer/license.txt"
DSET_DIR="/projects/bigos_lab/$DATASET-study/$COHORT"
BIDS_DIR="$DSET_DIR/dset"
IMG_DIR="/projects/bigos_lab/apptainer-images/fmriprep-$FMRIPREP_VERSION.simg"

TEMPLATEFLOW_HOST_HOME="/projects/bigos_lab/templateflow"

# Check values passed to script to process specific subjects
SUBJECTS=( $@ )
ARR_LEN=${#SUBJECTS[@]}
for ((i = 0; i < ARR_LEN; i++)); do
        subject_id=${SUBJECTS[$i]}
        if [[ $subject_id != sub-* ]]; then
                SUBJECTS[$i]="sub-${subject_id}"
        fi
done

# slurm job value; essentially extracting sub-{id}
if (( ARR_LEN == 0 )); then
	# https://catonmat.net/awk-one-liners-explained-part-two
	SUBJECT=$(awk -v line=$((SLURM_ARRAY_TASK_ID + 2)) 'NR==line { sub(/\r$/,""); print $1 }' "$BIDS_DIR/participants.tsv")
else
	SUBJECT=${SUBJECTS[${SLURM_ARRAY_TASK_ID}]}
fi

DERIVS_DIR="$BIDS_DIR/derivatives/fmriprep-$FMRIPREP_VERSION"
mkdir -p $DERIVS_DIR

FREESURFER_DIR="$DERIVS_DIR/sourcedata/freesurfer"
mkdir -p $FREESURFER_DIR

# https://grahamwatts.co.uk/blog/2024/10/09/lock-files-in-bash/
# https://stackoverflow.com/questions/185451/quick-and-dirty-way-to-ensure-only-one-instance-of-a-shell-script-is-running-at
# https://github.com/nipreps/fmriprep/issues/3258#issuecomment-2032118214
# To help with race condition, use file locking so that only one process copies the folder and the other
# processes wait to prevent interleaved writes and corrupted files
if [[ ! -f "$FREESURFER_DIR/fsaverage.done" ]]; then
	if mkdir "$FREESURFER_DIR/fsaverage.lock" 2>/dev/null; then
		apptainer exec -B $DERIVS_DIR:/out $IMG_DIR cp -r /opt/freesurfer/subjects/fsaverage /out/sourcedata/freesurfer
		touch "$FREESURFER_DIR/fsaverage.done"
	else
		while [[ ! -f "$FREESURFER_DIR/fsaverage.done" ]]; do
			sleep 10
		done
	fi
fi

SCRATCH_DIR="/scratch/$USER/$DATASET/$COHORT/fmriprep-$FMRIPREP_VERSION/$SUBJECT"
mkdir -p $SCRATCH_DIR

TMP_DIR="$SCRATCH_DIR/tmp"
mkdir -p $TMP_DIR

# Directory within the container templateflow will be in
APPTAINERENV_TEMPLATEFLOW_HOME="/home/fmriprep/.cache/${COHORT}_templateflow"
export APPTAINERENV_TEMPLATEFLOW_HOME

# https://apptainer.org/docs/user/main/bind_paths_and_mounts.html
APPTAINER_CMD="apptainer run --containall --writable-tmpfs --cleanenv \
	-B $BIDS_DIR:/data \
	-B $DERIVS_DIR:/out \
	-B $TEMPLATEFLOW_HOST_HOME:$APPTAINERENV_TEMPLATEFLOW_HOME:ro \
	-B $SCRATCH_DIR:/work \
	-B $TMP_DIR:/tmp \
	-B $FS_LICENSE:/freesurfer \
	$IMG_DIR"

if [[ $COHORT == "kids" ]]; then
	# https://neurostars.org/t/problems-using-pediatric-template-from-templateflow/4566/3
	SKULL_STRIP_TEMPLATE="--skull-strip-template MNIPediatricAsym:cohort-1"
	OUTPUT_SPACES="--output-spaces MNIPediatricAsym:cohort-1:res-2"
else
	SKULL_STRIP_TEMPLATE="--skull-strip-template OASIS30ANTs"
	OUTPUT_SPACES="--output-spaces MNI152NLin2009cAsym:res-2"
fi

# All data uses Sense acceleration of 3, so every third line in k-space is
# collected; distortion is minimizes. Also no field maps collected
# https://pubmed.ncbi.nlm.nih.gov/37517572/
# Usage Notes: https://fmriprep.org/en/stable/usage.html
CMD="$APPTAINER_CMD \
	/data \
	/out \
	participant \
	--participant-label $SUBJECT \
	-w /work \
	-vv \
	--omp-nthreads 16 \
	--nprocs 16 \
	--mem_mb 90000 \
	--low-mem \
	--notrack \
	--skip-bids-validation \
	--ignore fieldmaps \
	$SKULL_STRIP_TEMPLATE \
	--subject-anatomical-reference first-lex \
	--slice-time-ref 0 \
	$OUTPUT_SPACES \
	--fs-license-file /freesurfer"

echo Task ID: $SLURM_ARRAY_TASK_ID
echo Commandline: $CMD
eval $CMD

echo Exit Code: $?
date
exit $?
