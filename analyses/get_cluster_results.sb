#!/bin/bash
#SBATCH --job-name=get_cluster_results
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=48G
# Outputs ----------------------------------------------------------------------------
#SBATCH --output=/projects/bigos_lab/mph-study/code/logs/get_cluster_results_%A_%a.out
#SBATCH --error=/projects/bigos_lab/mph-study/code/logs/get_cluster_results_%A_%a.err
# -------------------------------------------------------------------------------------
BAD_NODES_FILE="/projects/bigos_lab/mph-study/code/logs/bad_nodes_${SLURM_ARRAY_JOB_ID}.txt"

if ! getent passwd $(id -u) > /dev/null 2>&1; then
    echo $(hostname) >> $BAD_NODES_FILE
    sort -u -o $BAD_NODES_FILE $BAD_NODES_FILE
    echo "Can't determine user account information on $(hostname). Requeueing job"
    SCONTROL_STRING="update JobId=${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} ExcNodeList=$(paste -sd, $BAD_NODES_FILE)"
    scontrol requeue ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}
    scontrol $SCONTROL_STRING
    exit 0
fi

ANALYSIS_TYPE=${ANALYSIS_TYPE:-glm} # glm or gPPI
METHOD=${METHOD:-parametric}

COHORT=${COHORT:-"kids"}                            # Choose "kids" or "adults"
BIDS_DIR="/projects/bigos_lab/mph-study/$COHORT/dset"
PYTHON="/projects/bigos_lab/envs/py313/bin/python"
AFNI_IMG_PATH="/projects/bigos_lab/apptainer-images/afni-26.1.02.simg"

DEFAULT_TASKS=("nback" "mtle" "mtlr" "princess" "flanker")

# sbatch --array=0 get_cluster_results.sb # values map to SLURM_ARRAY_TASK_ID for indexing TASK array
TASKS=( $@ )
# slurm job value; essentially extracting sub-{id}
if [ ${#TASKS[@]} -eq 0 ]; then
    TASK=${DEFAULT_TASKS[${SLURM_ARRAY_TASK_ID}]}
else
	TASK=${TASKS[${SLURM_ARRAY_TASK_ID}]}
fi

SECOND_LEVEL_REPORT_DIR="$BIDS_DIR/derivatives/$ANALYSIS_TYPE/reports/second_level/$TASK"
ANALYSIS_DIR="$BIDS_DIR/derivatives/$ANALYSIS_TYPE/$TASK"

TEMPLATE_MASK_PATH=${TEMPLATE_MASK_PATH:-"/projects/bigos_lab/templateflow/tpl-MNIPediatricAsym/cohort-1/tpl-MNIPediatricAsym_cohort-1_res-2_desc-brain_mask.nii.gz"}
TEMPLATE_IMG_PATH=${TEMPLATE_IMG_PATH:-"/projects/bigos_lab/templateflow/tpl-MNIPediatricAsym/cohort-1/tpl-MNIPediatricAsym_cohort-1_res-1_T1w.nii.gz"}

PARAMETRAIAC_VOXEL_CORRECTION_P=${PARAMETRAIAC_VOXEL_CORRECTION_P:-0.001}
PARAMETRAIAC_CLUSTER_CORRECTION_P=${PARAMETRAIAC_CLUSTER_CORRECTION_P:-0.05}
PARAMETRIC_CONNECTIVITY=${PARAMETRIC_CONNECTIVITY:-"NN1"}
SPHERE_RADIUS=${SPHERE_RADIUS:-5.0}

SEED_MASK_PATH=${SEED_MASK_PATH:-""}

CMD="$PYTHON get_cluster_results.py \
    --second_level_report_dir $SECOND_LEVEL_REPORT_DIR \
    --analysis_dir $ANALYSIS_DIR \
    --dst_dir $ANALYSIS_DIR \
    --method $METHOD \
    --cohort $COHORT \
	--task $TASK \
    --analysis_type $ANALYSIS_TYPE \
    --template_mask_path $TEMPLATE_MASK_PATH \
    --template_img_path $TEMPLATE_IMG_PATH \
    --sphere_radius $SPHERE_RADIUS"

if [[ $METHOD == "parametric" ]]; then
	CMD+=" --afni_img_path $AFNI_IMG_PATH --parametric_voxel_correction_p $PARAMETRAIAC_VOXEL_CORRECTION_P --parametric_cluster_correction_p $PARAMETRAIAC_CLUSTER_CORRECTION_P --parametric_connectivity $PARAMETRIC_CONNECTIVITY"
fi

if [[ $ANALYSIS_TYPE == "gPPI" && -n $SEED_MASK_PATH ]]; then
	CMD+=" --seed_mask_path $SEED_MASK_PATH"
fi

echo Task ID: $SLURM_ARRAY_TASK_ID
echo Commandline: $CMD
eval $CMD
EXITCODE=$?

echo Exit Code: $EXITCODE
date
exit $EXITCODE
